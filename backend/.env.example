# Copia in `.env` e riempi. `.env` e' in .gitignore: il repository e' pubblico.

# --- Obbligatorie: senza queste il servizio NON PARTE, e dice quale manca ---

# Postgres, driver asincrono. In locale con Docker:
#   docker run -d --name centro-db -e POSTGRES_PASSWORD=centro -p 5432:5432 postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:centro@localhost:5432/postgres

# La chiave con cui si firmano i gettoni. Almeno 32 caratteri.
# Generane una vera cosi', e NON riusare quella di sviluppo in produzione:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHIAVE_JWT=cambiami-con-una-chiave-vera-di-almeno-32-caratteri

# --- Facoltative: i valori qui sotto sono gia' i predefiniti ---------------

AMBIENTE=sviluppo
ORIGINI=http://localhost:4330,http://localhost:3000
MINUTI_ACCESSO=15
GIORNI_RINNOVO=30
TENTATIVI_ACCESSO=8
TENTATIVI_REGISTRAZIONE=5
FINESTRA_LIMITE_S=900

# --- IN PRODUZIONE CAMBIANO QUESTE TRE, e senza non funziona nulla --------
#
# Il sito sta su un dominio e questa API su un altro: per il browser sono due
# siti diversi, e un cookie `lax` non viene mandato. Servono:
#
#   AMBIENTE=produzione
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
#   ORIGINI=https://il-tuo-dominio.it
#
# `COOKIE_SECURE=true` richiede HTTPS su ENTRAMBI. Su http l'accesso sembra
# riuscire e poi la sessione non dura oltre il caricamento della pagina.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
