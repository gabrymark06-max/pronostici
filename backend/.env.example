# Copia in `.env` e riempi. `.env` e' in .gitignore: il repository e' pubblico.

# --- Obbligatorie: senza queste il servizio NON PARTE, e dice quale manca ---

# Postgres, driver asincrono. In locale con Docker:
#   docker run -d --name centro-db -e POSTGRES_PASSWORD=centro -p 5432:5432 postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:centro@localhost:5432/postgres

# La chiave con cui si firmano i gettoni. Almeno 32 caratteri.
# Generane una vera cosi', e NON riusare quella di sviluppo in produzione:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHIAVE_JWT=cambiami-con-una-chiave-vera-di-almeno-32-caratteri

# --- Facoltative: i valori qui sotto sono gia' i predefiniti ---------------

AMBIENTE=sviluppo
ORIGINI=http://localhost:4330,http://localhost:3000
MINUTI_ACCESSO=15
GIORNI_RINNOVO=30
TENTATIVI_ACCESSO=8
TENTATIVI_REGISTRAZIONE=5
FINESTRA_LIMITE_S=900

# --- IN PRODUZIONE CAMBIANO QUESTE TRE, e senza non funziona nulla --------
#
# Il sito sta su un dominio e questa API su un altro: per il browser sono due
# siti diversi, e un cookie `lax` non viene mandato. Servono:
#
#   AMBIENTE=produzione
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
#   ORIGINI=https://il-tuo-dominio.it
#
# `COOKIE_SECURE=true` richiede HTTPS su ENTRAMBI. Su http l'accesso sembra
# riuscire e poi la sessione non dura oltre il caricamento della pagina.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- POSTA ---------------------------------------------------------------
#
# `finta` (predefinito) scrive il messaggio nei log invece di spedirlo: e' cosi'
# che si prova il giro completo — conferma dell'indirizzo, recupero password —
# senza un account SMTP e senza spedire niente a nessuno per sbaglio.
#
# E' il predefinito di proposito. Un servizio che crede di spedire e non
# spedisce lascia le persone ad aspettare un'email che non arrivera', e nessun
# log dice niente perche' non c'e' stato nessun errore.
POSTA_MODO=finta

# Per spedire davvero: POSTA_MODO=smtp e queste quattro.
POSTA_DA=Centro <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORTA=587
SMTP_UTENTE=
SMTP_PASSWORD=

# L'indirizzo del SITO, non dell'API: e' quello che finisce nei collegamenti
# dentro le email, e chi li apre deve atterrare sul sito.
SITO=http://localhost:4330

# Quanto vale un collegamento ricevuto per posta.
ORE_GETTONE_EMAIL=24

# Le rotte che SPEDISCONO vanno strette piu' delle altre: senza, un indirizzo
# qualunque diventa il bersaglio di una valanga di email partite dal nostro
# dominio, e a rimetterci e' la reputazione del mittente.
TENTATIVI_POSTA=3
