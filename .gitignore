# Segreti — MAI committare. Il repository è pubblico.
.env
.env.local
*.key

# Cache di Sofascore. Fuori dal repository per due ragioni, e la seconda è
# quella che conta:
#
#   1. è cache con scadenza a sette giorni, rigenerabile in pochi minuti: in
#      un repository sarebbe rumore a ogni esecuzione;
#   2. sono statistiche di stagione di centinaia di giocatori prese da una
#      fonte terza, e questo repository è PUBBLICO. Mostrarne qualche numero
#      su una pagina è una cosa; ripubblicare l'archivio è un'altra.
data/sofascore/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
.next/
out/
dist/

# Cache locale delle risposte API (non è il ledger)
data/cache/

# Sistema
.DS_Store
Thumbs.db

# Backend dei conti: ambiente locale, database di prova e avvio a mano
backend/.venv/
backend/*.db
backend/avvia_prova.py
backend/src/*.egg-info/
