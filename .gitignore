# Segreti — MAI committare. Il repository è pubblico.
.env
.env.local
*.key

# Cache di Sofascore — SOLO l'archivio dei giocatori.
#
# Sono statistiche di stagione di centinaia di giocatori prese da una fonte
# terza, e questo repository è PUBBLICO. Mostrarne qualche numero su una pagina
# è una cosa; ripubblicare l'archivio è un'altra.
data/sofascore/giocatori.json

# `data/sofascore/squadre.json` INVECE ci sta, ed è una decisione presa quando
# il job è passato su GitHub Actions. Sono 74 righe nome→identificativo: non è
# un archivio di terzi, è la nostra tabella di corrispondenze. Fuori dal
# repository ogni esecuzione su un runner pulito ripartirebbe da zero e
# rifarebbe 74 ricerche per nome — più lento, e soprattutto più occasioni di
# agganciare la squadra sbagliata.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
.next/
out/
dist/

# Cache locale delle risposte API (non è il ledger)
data/cache/

# Sistema
.DS_Store
Thumbs.db

# Backend dei conti: ambiente locale, database di prova e avvio a mano
backend/.venv/
backend/*.db
backend/avvia_prova.py
backend/src/*.egg-info/

# Il link locale a Vercel: contiene org e project id, si rifà con `vercel link`.
.vercel/
