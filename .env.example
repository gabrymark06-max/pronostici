# Copia questo file in .env e riempi i valori.
# .env è in .gitignore e non deve MAI finire nel repository: è pubblico.
# In produzione questi valori vivono nei GitHub Actions Secrets, non in un file.

# football-data.org — piano gratuito
# Registrazione: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# the-odds-api — piano gratuito, 500 crediti/mese
# Registrazione: https://the-odds-api.com/#get-access
ODDS_API_KEY=

# Tetto di sicurezza sui crediti quote consumati in un mese.
# Sotto i 500 del piano, per lasciare margine agli errori.
ODDS_CREDIT_CAP=250
